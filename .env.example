# 运行模式：demo（默认）或 live
DATA_MODE=demo

# 扶摇官方 REST API（仅 DATA_MODE=live 时需要）
FUYAO_BASE_URL=https://fuyao.aicubes.cn
FUYAO_API_KEY=
# Live 直连模式显式提供最多 20 个完整 thscode，避免对全市场逐股扇出请求
FUYAO_THSCODES=600519.SH,000001.SZ
FUYAO_REPORT=2025-3

# 可选：OpenAI-compatible Chat Completions 服务
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-5-mini
