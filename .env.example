# 运行模式：demo（默认）或 live
DATA_MODE=demo

# 扶摇官方 REST API（仅 DATA_MODE=live 时需要）
FUYAO_BASE_URL=https://fuyao.aicubes.cn
FUYAO_API_KEY=
# Live 直连模式显式提供最多 20 个完整 thscode，避免对全市场逐股扇出请求
FUYAO_THSCODES=600519.SH,000001.SZ,000858.SZ,600036.SH,601318.SH,300750.SZ,002594.SZ,600900.SH,601899.SH,600030.SH,600000.SH,601398.SH,601288.SH,601988.SH,600028.SH,601857.SH,600887.SH,000333.SZ,000651.SZ,002415.SZ
# 留空时逐股使用利润表中最新已披露报告期；也可显式指定 yyyy-1/2/3/4
FUYAO_REPORT=

# 可选：OpenAI-compatible Chat Completions 服务
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-5-mini
